{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "nanocodex#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/js/scripts/**",
        "$TURBO_ROOT$/crates/nanocode/**",
        "$TURBO_ROOT$/crates/nanocode-agent/**",
        "$TURBO_ROOT$/crates/nanocode-backend-claude/**",
        "$TURBO_ROOT$/crates/nanocode-durability/**",
        "$TURBO_ROOT$/crates/nanocode-home/**",
        "$TURBO_ROOT$/crates/nanocode-backend-codex/**",
        "$TURBO_ROOT$/crates/nanocode-subagents/**",
        "$TURBO_ROOT$/crates/nanocode-code-mode/**",
        "$TURBO_ROOT$/crates/nanocode-voice-protocol/**",
        "$TURBO_ROOT$/crates/nanocode-tools/**",
        "$TURBO_ROOT$/crates/nanocode-tools-macros/**",
        "$TURBO_ROOT$/crates/nanocode-types/**",
        "$TURBO_ROOT$/crates/nanocode-media/**",
        "$TURBO_ROOT$/crates/nanocode-tls/**",
        "$TURBO_ROOT$/crates/nanocode-rollout/**",
        "$TURBO_ROOT$/crates/nanocode-cua/**"
      ],
      "env": [
        "RUSTFLAGS",
        "CARGO_ENCODED_RUSTFLAGS",
        "RUSTC",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "CARGO_INCREMENTAL",
        "CARGO_PROFILE_*",
        "CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_*"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "CARGO_TERM_COLOR",
        "NANOCODEX_WASM_OPT",
        "NANOCODEX_BINARYEN_CACHE",
        "BINARYEN_CORES",
        "CARGO_BUILD_JOBS",
        "CARGO_TARGET_DIR",
        "SCCACHE_*",
        "ACTIONS_CACHE_URL",
        "ACTIONS_RESULTS_URL",
        "ACTIONS_RUNTIME_TOKEN",
        "ACTIONS_CACHE_SERVICE_V2"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
